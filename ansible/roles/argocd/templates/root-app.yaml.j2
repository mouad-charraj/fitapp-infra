# Managed by Ansible (roles/argocd). The single entry point of GitOps:
# Argo CD reads {{ gitops_repo_path }}/ in the gitops repo and creates every other app from there.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ gitops_repo_url }}
    targetRevision: {{ gitops_repo_revision }}
    path: {{ gitops_repo_path }}
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
