# GENERATED BY TERRAFORM (terraform/templates/inventory.tftpl) — do not edit by hand.

[master]
k3s-master ansible_host=${master_public_ip} private_ip=${master_private_ip}

[workers]
%{ for name, w in workers ~}
${name} ansible_host=${w.private_ip} private_ip=${w.private_ip}
%{ endfor ~}

[k3s_cluster:children]
master
workers

[k3s_cluster:vars]
ansible_user=${admin_user}
ansible_ssh_private_key_file=${ssh_private_key}
master_public_ip=${master_public_ip}
master_private_ip=${master_private_ip}

# Workers have no inbound internet access: Ansible reaches them THROUGH the master (bastion / jump host).
[workers:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -i ${ssh_private_key} -o UserKnownHostsFile=${known_hosts} -o StrictHostKeyChecking=accept-new -W %h:%p ${admin_user}@${master_public_ip}"'
